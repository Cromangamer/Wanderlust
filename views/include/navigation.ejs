<header>
  <div class="navigation">
    <i id="logo" class="fa-solid fa-w"></i>
    <h3><%= title %></h3>
  </div>


  <div class="headercontainer">
    <div class="autho">
      <% if(isLoggedIn) { %>
        <div class="user-icon">
          <i class="fa-solid fa-user user-icon"></i> <%= currentUser.username %>
        </div>

      <% } if(currentPath !== '/user/signin' && currentPath !== '/user/signup' && isLoggedIn == false ) { %>

        <a id="signin-btn" href="/user/signin">
          <span>Sign In</span>
        </a>

        <a id="signup" href="/user/signup">Sign Up</a>

      <% } %>
      <% if(isLoggedIn) { %>
        <a id="signup" href="/user/signout">Sign Out</a>
      <% } %>
    </div>
    <% if(currentPath !== '/user/signin' && currentPath !== '/user/signup'){ %>
    <form method="GET" action="/listings/new">
      <button id="create-listing-button">Create New Listing</button>
    </form>
    <% } %>
  </div>
</header>